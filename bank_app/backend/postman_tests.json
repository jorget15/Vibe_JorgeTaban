{
  "info": {
    "name": "Bank App API",
    "description": "Test collection for the Flask bank app backend. Base URL: http://127.0.0.1:5000/api\n\nRun the server first:\n  cd bank_app/backend\n  python app.py",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000/api",
      "type": "string"
    },
    {
      "key": "account_id",
      "value": "1",
      "type": "string",
      "description": "Change this to a real account ID from your database"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "description": "Quick liveness check. Should return { status: ok } with 200."
      },
      "response": [
        {
          "name": "Server is up",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "POST Login",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/login",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@bank.com\",\n  \"password\": \"admin123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Authenticates a user. Returns userId, name, email, isAdmin on success.\n\nFails with 401 if:\n- Email not found\n- Password is wrong\n- password_hash is NULL (user created via Postman before auth was added — needs backfill)\n- Account is soft-deleted"
      },
      "response": [
        {
          "name": "Success — admin user",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"userId\": 1,\n  \"name\": \"Admin\",\n  \"email\": \"admin@bank.com\",\n  \"isAdmin\": true\n}"
        },
        {
          "name": "Success — regular user",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"userId\": 2,\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"isAdmin\": false\n}"
        },
        {
          "name": "Fail — wrong password",
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"error\": \"Invalid credentials\"\n}"
        },
        {
          "name": "Fail — deleted account",
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"error\": \"Account is deactivated\"\n}"
        }
      ]
    },
    {
      "name": "POST Create Account",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/accounts",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"accountType\": \"CHECKING\",\n  \"password\": \"securepass123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Creates a new account.\n\nIf the email already exists, the existing user is reused (no duplicate user rows).\nIf the email is new, a new User row is created first, then the Account.\n\npassword is optional — omit it to create a user without login capability (for testing only).\nacountType can be CHECKING or SAVINGS."
      },
      "response": [
        {
          "name": "Success — new user + new account",
          "status": "Created",
          "code": 201,
          "body": "{\n  \"accountId\": 3,\n  \"accountType\": \"CHECKING\",\n  \"balance\": 0.0\n}"
        },
        {
          "name": "Success — existing user, new account",
          "status": "Created",
          "code": 201,
          "body": "{\n  \"accountId\": 4,\n  \"accountType\": \"SAVINGS\",\n  \"balance\": 0.0\n}"
        },
        {
          "name": "Fail — missing field",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"error\": \"...\"\n}"
        }
      ]
    },
    {
      "name": "GET Account Info (User View)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/accounts/{{account_id}}",
        "description": "Returns account details for the given account ID.\n\nIf the owner has been soft-deleted, name and email are masked:\n  name  → 'Deleted User'\n  email → 'deleted@deleted.com'\n\nThe balance and accountType are always returned as-is."
      },
      "response": [
        {
          "name": "Success — active user",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"accountId\": 1,\n  \"userName\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"balance\": 1500.00,\n  \"accountType\": \"CHECKING\"\n}"
        },
        {
          "name": "Success — deleted user (PII masked)",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"accountId\": 2,\n  \"userName\": \"Deleted User\",\n  \"email\": \"deleted@deleted.com\",\n  \"balance\": 250.00,\n  \"accountType\": \"SAVINGS\"\n}"
        },
        {
          "name": "Fail — account not found",
          "status": "Not Found",
          "code": 404,
          "body": "{\n  \"error\": \"Account not found\"\n}"
        }
      ]
    },
    {
      "name": "GET All Users (Admin View)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/users",
        "description": "Admin-only endpoint. Returns every user row including soft-deleted ones, with real name and email (no masking), plus all accounts they own.\n\nIn a production app this would require an auth token — for now it is unprotected."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "[\n  {\n    \"userId\": 1,\n    \"name\": \"Admin\",\n    \"email\": \"admin@bank.com\",\n    \"isDeleted\": false,\n    \"deletedAt\": null,\n    \"createdAt\": \"2025-01-10\",\n    \"accounts\": [\n      {\n        \"accountId\": 1,\n        \"accountType\": \"CHECKING\",\n        \"balance\": 5000.00\n      }\n    ]\n  },\n  {\n    \"userId\": 2,\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane@example.com\",\n    \"isDeleted\": true,\n    \"deletedAt\": \"2025-03-20\",\n    \"createdAt\": \"2025-02-01\",\n    \"accounts\": [\n      {\n        \"accountId\": 2,\n        \"accountType\": \"SAVINGS\",\n        \"balance\": 250.00\n      }\n    ]\n  }\n]"
        }
      ]
    },
    {
      "name": "POST Deposit",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/accounts/{{account_id}}/deposit",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Deposits a positive amount into the account. Records a DEPOSIT transaction. Returns updated balance."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"accountId\": 1,\n  \"balance\": 2000.00\n}"
        },
        {
          "name": "Fail — zero or negative amount",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"error\": \"Deposit amount must be positive\"\n}"
        }
      ]
    },
    {
      "name": "POST Withdraw",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/accounts/{{account_id}}/withdraw",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 200\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Withdraws a positive amount. Fails if balance is insufficient. Records a WITHDRAW transaction."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"accountId\": 1,\n  \"balance\": 1800.00\n}"
        },
        {
          "name": "Fail — insufficient funds",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"error\": \"Insufficient funds\"\n}"
        }
      ]
    },
    {
      "name": "POST Transfer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/accounts/{{account_id}}/transfer",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientAccountId\": 2,\n  \"amount\": 100\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Transfers money from one account to another. Both balance updates and both transaction records (TRANSFER_OUT on sender, TRANSFER_IN on recipient) are atomic — if anything fails, the entire operation rolls back.\n\nReturns the sender's updated balance."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"accountId\": 1,\n  \"balance\": 1700.00\n}"
        },
        {
          "name": "Fail — same account",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"error\": \"Cannot transfer to the same account\"\n}"
        },
        {
          "name": "Fail — recipient not found",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"error\": \"Recipient account not found\"\n}"
        }
      ]
    },
    {
      "name": "GET Transaction History",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/accounts/{{account_id}}/transactions",
        "description": "Returns the full transaction history for an account in reverse-chronological order.\n\nEach entry includes txnId, type (DEPOSIT / WITHDRAW / TRANSFER_OUT / TRANSFER_IN), amount, description, and date.\n\nTransfer entries cross-reference each other:\n  TRANSFER_OUT → 'Transfer to account #2'\n  TRANSFER_IN  → 'Transfer from account #1'"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "[\n  {\n    \"txnId\": 5,\n    \"type\": \"TRANSFER_OUT\",\n    \"amount\": 100.00,\n    \"description\": \"Transfer to account #2\",\n    \"date\": \"2025-03-25\"\n  },\n  {\n    \"txnId\": 3,\n    \"type\": \"WITHDRAW\",\n    \"amount\": 200.00,\n    \"description\": null,\n    \"date\": \"2025-03-24\"\n  },\n  {\n    \"txnId\": 1,\n    \"type\": \"DEPOSIT\",\n    \"amount\": 500.00,\n    \"description\": null,\n    \"date\": \"2025-03-20\"\n  }\n]"
        }
      ]
    },
    {
      "name": "DELETE Soft Delete Account",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/accounts/{{account_id}}",
        "description": "Soft-deletes the user who owns this account.\n\nNothing is physically removed. Only the is_deleted flag flips to true and deleted_at is set. The user row, account row, and all transaction rows remain in the database for auditing.\n\nAfter deletion:\n- GET /accounts/:id still works but returns masked PII (Deleted User / deleted@deleted.com)\n- GET /users (admin) still shows the real name and email\n- POST /login returns 401 'Account is deactivated'"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"accountId\": 1,\n  \"status\": \"deleted\"\n}"
        },
        {
          "name": "Fail — account not found",
          "status": "Not Found",
          "code": 404,
          "body": "{\n  \"error\": \"Account not found\"\n}"
        }
      ]
    }
  ]
}
